Name     mc92gal1v1 ;
PartNo   001 ;
Date     09/08/2025 ;
Revision 01 ;
Designer sergio ;
Company  none ;
Assembly None ;
Location  ;
Device   g22v10 ;

/* PIN DEFINITIONS */
/* input pins */
PIN 1   = CLK;
PIN 2   = A345; /* AND(A13-A15) */
PIN 3   = A112; /* AND(A11-A12)) */
PIN 4   = A2;
PIN 5   = A1;
PIN 6   = A0;
PIN 7   = RW;
PIN 8   = E;
PIN 9   = M47;
PIN 10  = D2;
PIN 11  = D1;
/*PIN 12  = GND;*/
PIN 13  = D0; 
       
/* output pins */
PIN 14  = NC1; /* livre, pode ser usado como output extra */
PIN 15  = OT_CS;
PIN 16  = PR_CS;
PIN 17  = M50_CS;
PIN 18  = RAM_OE;
PIN 19  = RAM_WE;
PIN 20  = VRAM_CS;
PIN 21  = RAM_CS;
PIN 22  = ROM_OE;
PIN 23  = ROM_CS;
/*PIN 24  = VCC;*/

/* LOGIC DEFINITIONS */

SLAST4K = A345 & A112;

/* outputs */
ROM_CS  = !(SLAST4K & A2); 
ROM_OE  = !(RW & E); /* falta considerar o page in/out */
RAM_CS  = A345;
VRAM_CS = !(A345 & !A112); 
RAM_WE  = !(!RW & E);
RAM_OE  = !(RW & E); /* falta considerar o page in/out */
M50_CS  = !(SLAST4K & !A2 & !A1) ;
PR_CS   = !(SLAST4K & !A2 & A1 & !A0) ;
OT_CS   = !(SLAST4K & !A2 & A1 & A0) ;

/* D0 bidirecional */
/*D0     = D0;*//* logica para saida D0 quando activo */
/*D0.OE  = RW;*/
