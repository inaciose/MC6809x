1107                         *     A S S I S T 0 9    C O M M A N D S
1108                         ***********************************************
1109                         
1110                         *************REGISTERS - DISPLAY AND CHANGE REGISTERS
1111 fc4a 8d 23              CREG    BSR     REGPRT          ; PRINT REGISTERS
1112 fc4c 4c                         INCA                    ; SET FOR CHANGE FUNCTION
1113 fc4d 8d 21                      BSR     REGCHG          ; GO CHANGE, DISPLAY REGISTERS
1114 fc4f 39                         RTS                     ; RETURN TO COMMAND PROCESSOR
1115                         
1116                         ********************************************
1117                         * REGPRT - PRINT/CHANGE REGISTERS SUBROUTINE
1118                         * WILL ABORT TO 'CMDBAD' IF OVERFLOW DETECTED DURING
1119                         * A CHANGE OPERATION. CHANGE DISPLAYS REGISTERS WHEN
1120                         * DONE.
1121                         
1122                         * REGISTER MASK LIST CONSISTS OF:
1123                         * A) CHARACTERS DENOTING REGISTER
1124                         * B) ZERO FOR ONE BYTE, -1 FOR TWO
1125                         * C) OFFSET ON STACK TO REGISTER POSITION
1126                         * INPUT: SP+4=STACKED REGISTERS
1127                         * A=0 PRINT, A#0 PRINT AND CHANGE
1128                         * OUTPUT: (ONLY FOR REGISTER DISPLAY)
1129                         * C=1 CONTROL-X ENTERED, C=0 OTHERWISE
1130                         * VOLATILE: D,X (CHANGE)
1131                         * B,X (DISPLAY)
1132                         *******************************************
1133                         
1134 fc50 50 43 ff 13        REGMSK  FCB     'P,'C,-1,19     ; PC REG
1135 fc54 41 00 0a                   FCB     'A,0,10         ; A REG
1136 fc57 42 00 0b                   FCB     'B,0,11         ; B REG
1137 fc5a 58 ff 0d                   FCB     'X,-1,13        ; X REG
1138 fc5d 59 ff 0f                   FCB     'Y,-1,15        ; Y REG
1139 fc60 55 ff 11                   FCB     'U,-1,17        ; U REG
1140 fc63 53 ff 01                   FCB     'S,-1,1         ; S REG
1141 fc66 43 43 00 09                FCB     'C,'C,0,9       ; CC REG
1142 fc6a 44 50 00 0c                FCB     'D,'P,0,12      ; DP REG
1143 fc6e 00                         FCB     0               ; END OF LIST
1144                         
1145 fc6f 4f                 REGPRT  CLRA                    ; SETUP PRINT ONLY FLAG
1146 fc70 30 e8 10           REGCHG  LEAX    4+12,S          ; READY STACK VALUE
1147 fc73 34 32                      PSHS    Y,X,A           ; SAVE ON STACK WITH OPTION
1148 fc75 31 8c d8                   LEAY    REGMSK,PCR      ; LOAD REGISTER MASK
1149 fc78 ec a0              REGP1   LDD     ,Y+             ; LOAD NEXT CHAR OR <=0
1150 fc7a 4d                         TSTA                    ; ? END OF CHARACTERS
1151 fc7b 2f 04                      BLE     REGP2           ; BRANCH NOT CHARACTER
1152 fc7d 3f                         SWI                     ; SEND TO CONSOLE
1153 fc7e 01                         FCB     OUTCH           ; FUNCTION BYTE
1154 fc7f 20 f7                      BRA     REGP1           ; CHECK NEXT
1155 fc81 86 2d              REGP2   LDA     #'-             ; READY '-'
1156 fc83 3f                         SWI                     ; SEND OUT
1157 fc84 01                         FCB     OUTCH           ; WITH OUTCH
1158 fc85 30 e5                      LEAX    B,S             ; X->REGISTER TO PRINT
1159 fc87 6d e4                      TST     ,S              ; ? CHANGE OPTION
1160 fc89 26 12                      BNE     REGCNG          ; BRANCH YES
1161 fc8b 6d 3f                      TST     -1,Y            ; ? ONE OR TWO BYTES
1162 fc8d 27 03                      BEQ     REGP3           ; BRANCH ZERO MEANS ONE
1163 fc8f 3f                         SWI                     ; PERFORM WORD HEX
1164 fc90 05                         FCB     OUT4HS          ; FUNCTION
1165 fc91 8c                         FCB     SKIP2           ; SKIP BYTE PRINT
1166 fc92 3f                 REGP3   SWI                     ; PERFORM BYTE HEX
1167 fc93 04                         FCB     OUT2HS          ; FUNCTION
1168 fc94 ec a0              REG4    LDD     ,Y+             ; TO FRONT OF NEXT ENTRY
1169 fc96 5d                         TSTB                    ; ? END OF ENTRIES
1170 fc97 26 df                      BNE     REGP1           ; LOOP IF MORE
1171 fc99 3f                         SWI                     ; FORCE NEW LINE
1172 fc9a 06                         FCB     PCRLF           ; FUNCTION
1173 fc9b 35 b2              REGRTN  PULS    PC,Y,X,A        ; RESTORE STACK AND RETURN
1174                         
1175 fc9d 8d 40              REGCNG  BSR     BLDNNB          ; INPUT BINARY NUMBER
1176 fc9f 27 10                      BEQ     REGNXC          ; IF CHANGE THEN JUMP
1177 fca1 81 0d                      CMPA    #CR             ; ? NO MORE DESIRED
1178 fca3 27 1e                      BEQ     REGAGN          ; BRANCH NOPE
1179 fca5 e6 3f                      LDB     -1,Y            ; LOAD SIZE FLAG
1180 fca7 5a                         DECB                    ; MINUS ONE
1181 fca8 50                         NEGB                    ; MAKE POSITIVE
1182 fca9 58                         ASLB                    ; TIMES TWO (=2 OR =4)
1183 fcaa 3f                 REGSKP  SWI                     ; PERFORM SPACES
1184 fcab 07                         FCB     SPACE           ; FUNCTION
1185 fcac 5a                         DECB
1186 fcad 26 fb                      BNE     REGSKP          ; LOOP IF MORE
1187 fcaf 20 e3                      BRA     REG4            ; CONTINUE WITH NEXT REGISTER
1188 fcb1 a7 e4              REGNXC  STA     ,S              ; SAVE DELIMITER IN OPTION
1189                         *                               ; (ALWAYS > 0)
1190 fcb3 dc 9f                      LDD     <NUMBER         ; OBTAIN BINARY RESULT
1191 fcb5 6d 3f                      TST     -1,Y            ; ? TWO BYTES WORTH
1192 fcb7 26 02                      BNE     REGTWO          ; BRANCH YES
1193 fcb9 a6 82                      LDA     ,-X             ; SETUP FOR TWO
1194 fcbb ed 84              REGTWO  STD     ,X              ; STORE IN NEW VALUE
1195 fcbd a6 e4                      LDA     ,S              ; RECOVER DELIMITER
1196 fcbf 81 0d                      CMPA    #CR             ; ? END OF CHANGES
1197 fcc1 26 d1                      BNE     REG4            ; NO, KEEP ON TRUCK'N
1198                         * MOVE STACKED DATA TO NEW STACK IN CASE STACK
1199                         * POINTER HAS CHANGED
1200 fcc3 30 8d 63 8e        REGAGN  LEAX    TSTACK,PCR      ; LOAD TEMP AREA
1201 fcc7 c6 15                      LDB     #21             ; LOAD COUNT
1202 fcc9 35 02              REGTF1  PULS    A               ; NEXT BYTE
1203 fccb a7 80                      STA     ,X+             ; STORE INTO TEMP
1204 fccd 5a                         DECB                    ; COUNT DOWN
1205 fcce 26 f9                      BNE     REGTF1          ; LOOP IF MORE
1206 fcd0 10 ee 88 ec                LDS     -20,X           ; LOAD NEW STACK POINTER
1207 fcd4 c6 15                      LDB     #21             ; LOAD COUNT AGAIN
1208 fcd6 a6 82              REGTF2 LDA      ,-X             ; NEXT TO STORE
1209 fcd8 34 02                     PSHS     A               ; BACK ONTO NEW STACK
1210 fcda 5a                        DECB                     ; COUNT DOWN
1211 fcdb 26 f9                     BNE      REGTF2          ; LOOP IF MORE
1212 fcdd 20 bc                     BRA      REGRTN          ; GO RESTART COMMAND
1213                         
1214                         *********************************************
1215                         * BLDNUM - BUILDS BINARY VALUE FROM INPUT HEX
1216                         * THE ACTIVE EXPRESSION HANDLER IS USED.
1217                         * INPUT: S=RETURN ADDRESS
1218                         * OUTPUT: A=DELIMITER WHICH TERMINATED VALUE
1219                         * (IF DELM NOT ZERO)
1220                         * "NUMBER"=WORD BINARY RESULT
1221                         * Z=1 IF INPUT RECEIVED, Z=0 IF NO HEX RECEIVED
1222                         * REGISTERS ARE TRANSPARENT
1223                         **********************************************
1224                         * EXECUTE SINGLE OR EXTENDED ROM EXPRESSION HANDLER
1225                         *
1226                         * THE FLAG "DELIM" IS USED AS FOLLOWS:
1227                         * DELIM=0 NO LEADING BLANKS, NO FORCED TERMINATOR
1228                         * DELIM=CHR ACCEPT LEADING 'CHR'S, FORCED TERMINATOR
1229 fcdf 4f                 BLDNNB  CLRA                    ; NO DYNAMIC DELIMITER
1230 fce0 8c                         FCB     SKIP2           ; SKIP NEXT INSTRUCTION
1231                         * BUILD WITH LEADING BLANKS
1232 fce1 86 20              BLDNUM  LDA     #'              ; ALLOW LEADING BLANKS
1233 fce3 97 92                      STA     <DELIM          ; STORE AS DELIMITER
1234 fce5 6e 9d 64 07                JMP     [VECTAB+.EXPAN,PCR]   ; TO EXP ANALYZER
1235                         * THIS IS THE DEFAULT SINGLE ROM ANALYZER. WE ACCEPT:
1236                         * 1) HEX INPUT
1237                         * 2) 'M' FOR LAST MEMORY EXAMINE ADDRESS
1238                         * 3) 'P' FOR PROGRAM COUNTER ADDRESS
1239                         * 4) 'W' FOR WINDOW VALUE
1240                         * 5) '@' FOR INDIRECT VALUE
1241                         
1242 fce9 34 14              EXP1    PSHS    X,B             ; SAVE REGISTERS
1243 fceb 8d 5c              EXPDLM  BSR     BLDHXI          ; CLEAR NUMBER, CHECK FIRST CHAR
1244 fced 27 18                      BEQ     EXP2            ; IF HEX DIGIT CONTINUE BUILDING
1245                         * SKIP BLANKS IF DESIRED
1246 fcef 91 92                      CMPA    <DELIM          ; ? CORRECT DELIMITER
1247 fcf1 27 f8                      BEQ     EXPDLM          ; YES, IGNORE IT
1248                         * TEST FOR M OR P
1249 fcf3 9e a2                      LDX     <ADDR           ; DEFAULT FOR 'M'
1250 fcf5 81 4d                      CMPA    #'M             ; ? MEMORY EXAMINE ADDR WANTED
1251 fcf7 27 16                      BEQ     EXPTDL          ; BRANCH IF SO
1252 fcf9 9e 97                      LDX     <PCNTER         ; DEFAULT FOR 'P'
1253 fcfb 81 50                      CMPA    #'P             ; ? LAST PROGRAM COUNTER WANTED
1254 fcfd 27 10                      BEQ     EXPTDL          ; BRANCH IF SO
1255 fcff 9e a4                      LDX     <WINDOW         ; DEFAULT TO WINDOW
1256 fd01 81 57                      CMPA    #'W             ; ? WINDOW WANTED
1257 fd03 27 0a                      BEQ     EXPTDL
1258                         
1259 fd05 35 94              EXPRTN  PULS    PC,X,B          ; RETURN AND RESTORE REGISTERS
1260                         * GOT HEX, NOW CONTINUE BUILDING
1261 fd07 8d 44              EXP2    BSR     BLDHEX          ; COMPUTE NEXT DIGIT
1262 fd09 27 fc                      BEQ     EXP2            ; CONTINUE IF MORE
1263 fd0b 20 0a                      BRA     EXPCDL          ; SEARCH FOR +/-
1264                         * STORE VALUE AND CHECK IF NEED DELIMITER
1265 fd0d ae 84              EXPTDI  LDX     ,X              ; INDIRECTION DESIRED
1266 fd0f 9f 9f              EXPTDL  STX     <NUMBER         ; STORE RESULT
1267 fd11 0d 92                      TST     <DELIM          ; ? TO FORCE A DELIMITER
1268 fd13 27 f0                      BEQ     EXPRTN          ; RETURN IF NOT WITH VALUE
1269 fd15 8d 62                      BSR     READ            ; OBTAIN NEXT CHARACTER
1270                         * TEST FOR + OR -
1271 fd17 9e 9f              EXPCDL  LDX     <NUMBER         ; LOAD LAST VALUE
1272 fd19 81 2b                      CMPA    #'+             ; ? ADD OPERATOR
1273 fd1b 26 0e                      BNE     EXPCHM          ; BRANCH NOT
1274 fd1d 8d 23                      BSR     EXPTRM          ; COMPUTE NEXT TERM
1275 fd1f 34 02                      PSHS    A               ; SAVE DELIMITER
1276 fd21 dc 9f                      LDD     <NUMBER         ; LOAD NEW TERM
1277 fd23 30 8b              EXPADD  LEAX    D,X             ; ADD TO X
1278 fd25 9f 9f                      STX     <NUMBER         ; STORE AS NEW RESULT
1279 fd27 35 02                      PULS    A               ; RESTORE DELIMITER
1280 fd29 20 ec                      BRA     EXPCDL          ; NOW TEST IT
1281 fd2b 81 2d              EXPCHM  CMPA    #'-             ; ? SUBTRACT OPERATOR
1282 fd2d 27 07                      BEQ     EXPSUB          ; BRANCH IF SO
1283 fd2f 81 40                      CMPA    #'@             ; ? INDIRECTION DESIRED
1284 fd31 27 da                      BEQ     EXPTDI          ; BRANCH IF SO
1285 fd33 5f                         CLRB                    ; SET DELIMITER RETURN
1286 fd34 20 cf                      BRA     EXPRTN          ; AND RETURN TO CALLER
1287 fd36 8d 0a              EXPSUB  BSR     EXPTRM          ; OBTAIN NEXT TERM
1288 fd38 34 02                      PSHS    A               ; SAVE DELIMITER
1289 fd3a dc 9f                      LDD     <NUMBER         ; LOAD UP NEXT TERM
1290 fd3c 40                         NEGA                    ; NEGATE A
1291 fd3d 50                         NEGB                    ; NEGATE B
1292 fd3e 82 00                      SBCA    #0              ; CORRECT FOR A
1293 fd40 20 e1                      BRA     EXPADD          ; GO ADD TO EXPRESSION
1294                         * COMPUTE NEXT EXPRESSION TERM
1295                         * OUTPUT: X=OLD VALUE
1296                         * 'NUMBER'=NEXT TERM
1297 fd42 8d 9d              EXPTRM  BSR     BLDNUM          ; OBTAIN NEXT VALUE
1298 fd44 27 32                      BEQ     CNVRTS          ; RETURN IF VALID NUMBER
1299 fd46 16 fc 13           BLDBAD  LBRA    CMDBAD          ; ABORT COMMAND IF INVALID
1300                         
1301                         *********************************************
1302                         * BUILD BINARY VALUE USING INPUT CHARACTERS.
1303                         * INPUT: A=ASCII HEX VALUE OR DELIMITER
1304                         * SP+0=RETURN ADDRESS
1305                         * SP+2=16 BIT RESULT AREA
1306                         * OUTPUT: Z=1 A=BINARY VALUE
1307                         * Z=0 IF INVALID HEX CHARACTER (A UNCHANGED)
1308                         * VOLATILE: D
1309                         ****************************************
1310 fd49 0f 9f              BLDHXI  CLR     <NUMBER         ; CLEAR NUMBER
1311 fd4b 0f a0                      CLR     <NUMBER+1       ; CLEAR NUMBER
1312 fd4d 8d 2a              BLDHEX  BSR     READ            ; GET INPUT CHARACTER
1313 fd4f 8d 11              BLDHXC  BSR     CNVHEX          ; CONVERT AND TEST CHARACTER
1314 fd51 26 25                      BNE     CNVRTS          ; RETURN IF NOT A NUMBER
1315 fd53 c6 10                      LDB     #16             ; PREPARE SHIFT
1316 fd55 3d                         MUL                     ; BY FOUR PLACES
1317 fd56 86 04                      LDA     #4              ; ROTATE BINARY INTO VALUE
1318 fd58 58                 BLDSHF  ASLB                    ; OBTAIN NEXT BIT
1319 fd59 09 a0                      ROL     <NUMBER+1       ; INTO LOW BYTE
1320 fd5b 09 9f                      ROL     <NUMBER         ; INTO HI BYTE
1321 fd5d 4a                         DECA                    ; COUNT DOWN
1322 fd5e 26 f8                      BNE     BLDSHF          ; BRANCH IF MORE TO DO
1323 fd60 20 14                      BRA     CNVOK           ; SET GOOD RETURN CODE
1324                         
1325                         ****************************************
1326                         * CONVERT ASCII CHARACTER TO BINARY BYTE
1327                         * INPUT: A=ASCII
1328                         * OUTPUT: Z=1 A=BINARY VALUE
1329                         * Z=0 IF INVALID
1330                         * ALL REGISTERS TRANSPARENT
1331                         * (A UNALTERED IF INVALID HEX)
1332                         **************************************
1333 fd62 81 30              CNVHEX  CMPA    #'0             ; ? LOWER THAN A ZERO
1334 fd64 25 12                      BLO     CNVRTS          ; BRANCH NOT VALUE
1335 fd66 81 39                      CMPA    #'9             ; ? POSSIBLE A-F
1336 fd68 2f 0a                      BLE     CNVGOT          ; BRANCH NO TO ACCEPT
1337 fd6a 81 41                      CMPA    #'A             ; ? LESS THEN TEN
1338 fd6c 25 0a                      BLO     CNVRTS          ; RETURN IF MINUS (INVALID)
1339 fd6e 81 46                      CMPA    #'F             ; ? NOT TOO LARGE
1340 fd70 22 06                      BHI     CNVRTS          ; NO, RETURN TOO LARGE
1341 fd72 80 07                      SUBA    #7              ; DOWN TO BINARY
1342 fd74 84 0f              CNVGOT  ANDA    #$0F            ; CLEAR HIGH HEX
1343 fd76 1a 04              CNVOK   ORCC    #4              ; FORCE ZERO ON FOR VALID HEX
1344 fd78 39                 CNVRTS  RTS                     ; RETURN TO CALLER
1345                         
1346                         * GET INPUT CHAR, ABORT COMMAND IF CONTROL-X (CANCEL)
1347 fd79 3f                 READ     SWI                    ; GET NEXT CHARACTER
1348 fd7a 00                          FCB    INCHNP          ; FUNCTION
1349 fd7b 81 18                       CMPA   #CAN            ; ? ABORT COMMAND
1350 fd7d 27 c7                       BEQ    BLDBAD          ; BRANCH TO ABORT IF SO
1351 fd7f 39                          RTS                    ; RETURN TO CALLER
1352                         *G
1353                         
1354                         ***************GO - START PROGRAM EXECUTION
1355 fd80 8d 01              CGO      BSR    GOADDR          ; BUILD ADDRESS IF NEEDED
1356 fd82 3b                          RTI                    ; START EXECUTING
1357                         
1358                         * FIND OPTIONAL NEW PROGRAM COUNTER. ALSO ARM THE
1359                         * BREAKPOINTS.
1360 fd83 35 30              GOADDR   PULS   Y,X             ; RECOVER RETURN ADDRESS
1361 fd85 34 10                       PSHS   X               ; STORE RETURN BACK
1362 fd87 26 19                       BNE    GONDFT          ; IF NO CARRIAGE RETURN THEN NEW PC
1363                         
1364                         * DEFAULT PROGRAM COUNTER, SO FALL THROUGH IF
1365                         * IMMEDIATE BREAKPOINT.
1366 fd89 17 01 b6                    LBSR   CBKLDR          ; SEARCH BREAKPOINTS
1367 fd8c ae 6c                       LDX    12,S            ; LOAD PROGRAM COUNTER
1368 fd8e 5a                 ARMBLP  DECB                    ; COUNT DOWN
1369 fd8f 2b 16                      BMI     ARMBK2          ; DONE, NONE TO SINGLE TRACE
1370 fd91 a6 30                      LDA     -NUMBKP*2,Y     ; PRE-FETCH OPCODE
1371 fd93 ac a1                      CMPX    ,Y++            ; ? IS THIS A BREAKPOINT
1372 fd95 26 f7                      BNE     ARMBLP          ; LOOP IF NOT
1373 fd97 81 3f                      CMPA    #$3F            ; ? SWI BREAKPOINTED
1374 fd99 26 02                      BNE     ARMNSW          ; NO, SKIP SETTING OF PASS FLAG
1375 fd9b 97 ff                      STA     <SWIBFL         ; SHOW UPCOMING SWI NOT BRKPNT
1376 fd9d 0c 93              ARMNSW  INC     <MISFLG         ; FLAG THRU A BREAKPOINT
1377 fd9f 16 01 06                   LBRA    CDOT            ; DO SINGLE TRACE W/O BREAKPOINTS
1378                         
1379                         * OBTAIN NEW PROGRAM COUNTER
1380 fda2 17 00 bb           GONDFT  LBSR    CDNUM           ; OBTAIN NEW PROGRAM COUNTER
1381 fda5 ed 6c                      STD     12,S            ; STORE INTO STACK
1382 fda7 17 01 98           ARMBK2  LBSR    CBKLDR          ; OBTAIN TABLE
1383 fdaa 00 fe                      NEG     <BKPTCT         ; COMPLEMENT TO SHOW ARMED
1384 fdac 5a                 ARMLOP  DECB                    ; ? DONE
1385 fdad 2b c9                      BMI     CNVRTS          ; RETURN WHEN DONE
1386 fdaf a6 b4                      LDA     [,Y]            ; LOAD OPCODE
1387 fdb1 a7 30                      STA     -NUMBKP*2,Y     ; STORE INTO OPCODE TABLE
1388 fdb3 86 3f                      LDA     #$3F            ; READY "SWI" OPCODE
1389 fdb5 a7 b1                      STA     [,Y++]          ; STORE AND MOVE UP TABLE
1390 fdb7 20 f3                      BRA     ARMLOP          ; AND CONTINUE
1391                         
1392                         *******************CALL - CALL ADDRESS AS SUBROUTINE
1393 fdb9 8d c8              CCALL   BSR     GOADDR          ; FETCH ADDRESS IF NEEDED
1394 fdbb 35 7f                      PULS    U,Y,X,DP,D,CC   ; RESTORE USERS REGISTERS
1395 fdbd ad f1                      JSR     [,S++]          ; CALL USER SUBROUTINE
1396 fdbf 3f                 CGOBRK  SWI                     ; PERFORM BREAKPOINT
1397 fdc0 0a                         FCB     BRKPT           ; FUNCTION
1398 fdc1 20 fc                      BRA     CGOBRK          ; LOOP UNTIL USER CHANGES PC
1399                         
1400                         ****************MEMORY - DISPLAY/CHANGE MEMORY
1401                         * CMEMN AND CMPADP ARE DIRECT ENTRY POINTS FROM
1402                         * THE COMMAND HANDLER FOR QUICK COMMANDS
1403 fdc3 17 00 9a           CMEM    LBSR    CDNUM           ; OBTAIN ADDRESS
1404 fdc6 dd a2              CMEMN   STD     <ADDR           ; STORE DEFAULT
1405 fdc8 9e a2              CMEM2   LDX     <ADDR           ; LOAD POINTER
1406 fdca 17 fc 0c                   LBSR    ZOUT2H          ; SEND OUT HEX VALUE OF BYTE
1407 fdcd 86 2d                      LDA     #'-             ; LOAD DELIMITER
1408 fdcf 3f                         SWI                     ; SEND OUT
1409 fdd0 01                         FCB     OUTCH           ; FUNCTION
1410 fdd1 17 ff 0b           CMEM4   LBSR    BLDNNB          ; OBTAIN NEW BYTE VALUE
1411 fdd4 27 0a                      BEQ     CMENUM          ; BRANCH IF NUMBER
1412                         * COMA - SKIP BYTE
1413 fdd6 81 2c                      CMPA    #',             ; ? COMMA
1414 fdd8 26 0e                      BNE     CMNOTC          ; BRANCH NOT
1415 fdda 9f a2                      STX     <ADDR           ; UPDATE POINTER
1416 fddc 30 01                      LEAX    1,X             ; TO NEXT BYTE
1417 fdde 20 f1                      BRA     CMEM4           ; AND INPUT IT
1418 fde0 d6 a0              CMENUM  LDB     <NUMBER+1       ; LOAD LOW BYTE VALUE
1419 fde2 8d 47                      BSR     MUPDAT          ; GO OVERLAY MEMORY BYTE
1420 fde4 81 2c                      CMPA    #',             ; ? CONTINUE WITH NO DISPLAY
1421 fde6 27 e9                      BEQ     CMEM4           ; BRANCH YES
1422                         * QUOTED STRING
1423 fde8 81 27              CMNOTC  CMPA    #$27            ; ? QUOTED STRING
1424 fdea 26 0c                      BNE     CMNOTQ          ; BRANCH NO
1425 fdec 8d 8b              CMESTR  BSR     READ            ; OBTAIN NEXT CHARACTER
1426 fdee 81 27                      CMPA    #$27            ; ? END OF QUOTED STRING
1427 fdf0 27 0c                      BEQ     CMSPCE          ; YES, QUIT STRING MODE
1428 fdf2 1f 89                      TFR     A,B             ; TO B FOR SUBROUTINE
1429 fdf4 8d 35                      BSR     MUPDAT          ; GO UPDATE BYTE
1430 fdf6 20 f4                      BRA     CMESTR          ; GET NEXT CHARACTER
1431                         * BLANK - NEXT BYTE
1432 fdf8 81 20              CMNOTQ  CMPA    #$20            ; ? BLANK FOR NEXT BYTE
1433 fdfa 26 06                      BNE     CMNOTB          ; BRANCH NOT
1434 fdfc 9f a2                      STX     <ADDR           ; UPDATE POINTER
1435 fdfe 3f                 CMSPCE  SWI                     ; GIVE SPACE
1436 fdff 07                         FCB     SPACE           ; FUNCTION
1437 fe00 20 c6                      BRA     CMEM2           ; NOW PROMPT FOR NEXT
1438                         
1439                         * LINE FEED - NEXT BYTE WITH ADDRESS
1440 fe02 81 0a              CMNOTB  CMPA    #LF             ; ? LINE FEED FOR NEXT BYTE
1441 fe04 26 08                      BNE     CMNOTL          ; BRANCH NO
1442 fe06 86 0d                      LDA     #CR             ; GIVE CARRIAGE RETURN
1443 fe08 3f                         SWI                     ; TO CONSOLE
1444 fe09 01                         FCB     OUTCH           ; HANDLER
1445 fe0a 9f a2                      STX     <ADDR           ; STORE NEXT ADDRESS
1446 fe0c 20 0a                      BRA     CMPADP          ; BRANCH TO SHOW
1447                         
1448                         * UP ARROW - PREVIOUS BYTE AND ADDRESS
1449 fe0e 81 5e              CMNOTL  CMPA    #'^             ; ? UP ARROW FOR PREVIOUS BYTE
1450 fe10 26 0a                      BNE     CMNOTU          ; BRANCH NOT
1451 fe12 30 1e                      LEAX    -2,X            ; DOWN TO PREVIOUS BYTE
1452 fe14 9f a2                      STX     <ADDR           ; STORE NEW POINTER
1453 fe16 3f                 CMPADS  SWI                     ; FORCE NEW LINE
1454 fe17 06                         FCB     PCRLF           ; FUNCTION
1455 fe18 8d 07              CMPADP  BSR     PRTADR          ; GO PRINT ITS VALUE
1456 fe1a 20 ac                      BRA     CMEM2           ; THEN PROMPT FOR INPUT
1457                         
1458                         * SLASH - NEXT BYTE WITH ADDRESS
1459 fe1c 81 2f              CMNOTU  CMPA    #'/             ; ? SLASH FOR CURRENT DISPLAY
1460 fe1e 27 f6                      BEQ     CMPADS          ; YES, SEND ADDRESS
1461 fe20 39                         RTS                     ; RETURN FROM COMMAND
1462                         
1463                         * PRINT CURRENT ADDRESS
1464 fe21 9e a2              PRTADR  LDX     <ADDR           ; LOAD POINTER VALUE
1465 fe23 34 10                      PSHS    X               ; SAVE X ON STACK
1466 fe25 30 e4                      LEAX    ,S              ; POINT TO IT FOR DISPLAY
1467 fe27 3f                         SWI                     ; DISPLAY POINTER IN HEX
1468 fe28 05                         FCB     OUT4HS          ; FUNCTION
1469 fe29 35 90                      PULS    PC,X            ; RECOVER POINTER AND RETURN
1470                         
1471                         * UPDATE BYTE
1472 fe2b 9e a2              MUPDAT  LDX     <ADDR           ; LOAD NEXT BYTE POINTER
1473 fe2d e7 80                      STB     ,X+             ; STORE AND INCREMENT X
1474 fe2f e1 1f                      CMPB    -1,X            ; ? SUCCESFULL STORE
1475 fe31 26 03                      BNE     MUPBAD          ; BRANCH FOR '?' IF NOT
1476 fe33 9f a2                      STX     <ADDR           ; STORE NEW POINTER VALUE
1477 fe35 39                         RTS                     ; BACK TO CALLER
1478 fe36 34 02              MUPBAD  PSHS    A               ; SAVE A REGISTER
1479 fe38 86 3f                      LDA     #'?             ; SHOW INVALID
1480 fe3a 3f                         SWI                     ; SEND OUT
1481 fe3b 01                         FCB     OUTCH           ; FUNCTION
1482 fe3c 35 82                      PULS    PC,A            ; RETURN TO CALLER
1483                         
1484                         ********************WINDOW - SET WINDOW VALUE
1485 fe3e 8d 20              CWINDO  BSR     CDNUM           ; OBTAIN WINDOW VALUE
1486 fe40 dd a4                      STD     <WINDOW         ; STORE IT IN
1487 fe42 39                         RTS                     ; END COMMAND
1488                         
1489                         ******************DISPLAY - HIGH SPEED DISPLAY MEMORY
1490 fe43 8d 1b              CDISP   BSR     CDNUM           ; FETCH ADDRESS
1491 fe45 c4 f0                      ANDB    #$F0            ; FORCE TO 16 BOUNDARY
1492 fe47 1f 02                      TFR     D,Y             ; SAVE IN Y
1493 fe49 30 2f                      LEAX    15,Y            ; DEFAULT LENGTH
1494 fe4b 25 04                      BCS     CDISPS          ; BRANCH IF END OF INPUT
1495 fe4d 8d 11                      BSR     CDNUM           ; OBTAIN COUNT
1496 fe4f 30 ab                      LEAX    D,Y             ; ASSUME COUNT, COMPUTE END ADDR
1497 fe51 34 30              CDISPS  PSHS    Y,X             ; SETUP PARAMETERS FOR HSDATA
1498 fe53 10 a3 62                   CMPD    2,S             ; ? WAS IT COUNT
1499 fe56 23 02                      BLS     CDCNT           ; BRANCH YES
1500 fe58 ed e4                      STD     ,S              ; STORE HIGH ADDRESS
1501 fe5a ad 9d 62 88        CDCNT   JSR     [VECTAB+.HSDTA,PCR] ; CALL PRINT ROUTINE
1502 fe5e 35 e0                      PULS    PC,U,Y          ; CLEAN STACK AND END COMMAND
1503                         
1504                         * OBTAIN NUMBER - ABORT IF NONE
1505                         * ONLY DELIMITERS OF CR, BLANK, OR '/' ARE ACCEPTED
1506                         * OUTPUT: D=VALUE, C=1 IF CARRIAGE RETURN DELMITER,
1507                         * ELSE C=0
1508 fe60 17 fe 7e           CDNUM   LBSR    BLDNUM          ; OBTAIN NUMBER
1509 fe63 26 09                      BNE     CDBADN          ; BRANCH IF INVALID
1510 fe65 81 2f                      CMPA    #'/             ; ? VALID DELIMITER
1511 fe67 22 05                      BHI     CDBADN          ; BRANCH IF NOT FOR ERROR
1512 fe69 81 0e                      CMPA    #CR+1           ; LEAVE COMPARE FOR CARRIAGE RET
1513 fe6b dc 9f                      LDD     <NUMBER         ; LOAD NUMBER
1514 fe6d 39                         RTS                     ; RETURN WITH COMPARE
1515 fe6e 16 fa eb           CDBADN  LBRA    CMDBAD          ; RETURN TO ERROR MECHANISM
1516                         
1517                         *****************PUNCH - PUNCH MEMORY IN S1-S9 FORMAT
1518 fe71 8d ed              CPUNCH  BSR     CDNUM           ; OBTAIN START ADDRESS
1519 fe73 1f 02                      TFR     D,Y             ; SAVE IN Y
1520 fe75 8d e9                      BSR     CDNUM           ; OBTAIN END ADDRESS
1521 fe77 6f e2                      CLR     ,-S             ; SETUP PUNCH FUNCTION CODE
1522 fe79 34 26                      PSHS    Y,D             ; STORE VALUES ON STACK
1523 fe7b ad 9d 62 69        CCALBS  JSR     [VECTAB+.BSON,PCR] ; INITIALIZE HANDLER
1524 fe7f ad 9d 62 67                JSR     [VECTAB+.BSDTA,PCR] ; PERFORM FUNCTION
1525 fe83 34 01                      PSHS    CC              ; SAVE RETURN CODE
1526 fe85 ad 9d 62 63                JSR     [VECTAB+.BSOFF,PCR] ; TURN OFF HANDLER
1527 fe89 35 01                      PULS    CC              ; OBTAIN CONDITION CODE SAVED
1528 fe8b 26 e1                      BNE     CDBADN          ; BRANCH IF ERROR
1529 fe8d 35 b2                      PULS    PC,Y,X,A        ; RETURN FROM COMMAND
1530                         
1531                         *****************LOAD - LOAD MEMORY FROM S1-S9 FORMAT
1532 fe8f 8d 01              CLOAD   BSR     CLVOFS          ; CALL SETUP AND PASS CODE
1533 fe91 01                         FCB     1               ; LOAD FUNCTION CODE FOR PACKET
1534                         
1535 fe92 33 f1              CLVOFS  LEAU    [,S++]          ; LOAD CODE IN HIGH BYTE OF U
1536 fe94 33 d4                      LEAU    [,U]            ; NOT CHANGING CC AND RESTORE S
1537 fe96 27 03                      BEQ     CLVDFT          ; BRANCH IF CARRIAGE RETURN NEXT
1538 fe98 8d c6                      BSR     CDNUM           ; OBTAIN OFFSET
1539 fe9a 8c                         FCB     SKIP2           ; SKIP DEFAULT OFFSET
1540 fe9b 4f                 CLVDFT  CLRA                    ; CREATE ZERO OFFSET
1541 fe9c 5f                         CLRB                    ; AS DEFAULT
1542 fe9d 34 4e                      PSHS    U,DP,D          ; SETUP CODE, NULL WORD, OFFSET
1543 fe9f 20 da                      BRA     CCALBS          ; ENTER CALL TO BS ROUTINES
1544                         
1545                         ******************VERIFY - COMPARE MEMORY WITH FILES
1546 fea1 8d ef              CVER    BSR     CLVOFS          ; COMPUTE OFFSET IF ANY
1547 fea3 ff                         FCB     -1              ; VERIFY FNCTN CODE FOR PACKET
1548                         
1549                         *******************TRACE - TRACE INSTRUCTIONS
1550                         ******************* . - SINGLE STEP TRACE
1551 fea4 8d ba              CTRACE  BSR     CDNUM           ; OBTAIN TRACE COUNT
1552 fea6 dd 95                      STD     <TRACEC         ; STORE COUNT
1553 fea8 32 62              CDOT    LEAS    2,S             ; RID COMMAND RETURN FROM STACK
1554 feaa ee f8 0a           CTRCE3  LDU     [10,S]          ; LOAD OPCODE TO EXECUTE
1555 fead df 9d                      STU     <LASTOP         ; STORE FOR TRACE INTERRUPT
1556 feaf de fa                      LDU     <VECTAB+.PTM    ; LOAD PTM ADDRESS
1557 feb1 cc 07 01                   LDD     #$0701          ; 7,1 CYCLES DOWN+CYCLES UP
1558 feb4 ed 42                      STD     PTMTM1-PTM,U    ; START NMI TIMEOUT
1559 feb6 3b                         RTI                     ; RETURN FOR ONE INSTRUCTION
1560                         
1561                         *************NULLS  -  SET NEW LINE AND CHAR PADDING
1562 feb7 8d a7              CNULLS  BSR     CDNUM           ; OBTAIN NEW LINE PAD
1563 feb9 dd f6                      STD     <VECTAB+.PAD    ; RESET VALUES
1564 febb 39                         RTS                     ; END COMMAND
1565                         
1566                         ******************STLEVEL - SET STACK TRACE LEVEL
1567 febc 27 05              CSTLEV  BEQ     STLDFT          ; TAKE DEFAULT
1568 febe 8d a0                      BSR     CDNUM           ; OBTAIN NEW STACK LEVEL
1569 fec0 dd fc                      STD     <SLEVEL         ; STORE NEW ENTRY
1570 fec2 39                         RTS                     ; TO COMMAND HANDLER
1571 fec3 30 6e              STLDFT  LEAX    14,S            ; COMPUTE NMI COMPARE
1572 fec5 9f fc                      STX     <SLEVEL         ; AND STORE IT
1573 fec7 39                         RTS                     ; END COMMAND
1574                         
1575                         ******************OFFSET - COMPUTE SHORT AND LONG
1576                         ******************                  BRANCH OFFSETS
1577 fec8 8d 96              COFFS   BSR     CDNUM           ; OBTAIN INSTRUCTION ADDRESS
1578 feca 1f 01                      TFR     D,X             ; USE AS FROM ADDRESS
1579 fecc 8d 92                      BSR     CDNUM           ; OBTAIN TO ADDRESS
1580                         * D=TO INSTRUCTION, X=FROM INSTRUCTION OFFSET BYTE(S)
1581 fece 30 01                      LEAX    1,X             ; ADJUST FOR *+2 SHORT BRANCH
1582 fed0 34 30                      PSHS    Y,X             ; STORE WORK WORD AND VALUE ON S
1583 fed2 a3 e4                      SUBD    ,S              ; FIND OFFSET
1584 fed4 ed e4                      STD     ,S              ; SAVE OVER STACK
1585 fed6 30 61                      LEAX    1,S             ; POINT FOR ONE BYTE DISPLAY
1586 fed8 1d                         SEX                     ; SIGN EXTEND LOW BYTE
1587 fed9 a1 e4                      CMPA    ,S              ; ? VALID ONE BYTE OFFSET
1588 fedb 26 02                      BNE     COFNO1          ; BRANCH IF NOT
1589 fedd 3f                         SWI                     ; SHOW ONE BYTE OFFSET
1590 fede 04                         FCB     OUT2HS          ; FUNCTION
1591 fedf ee e4              COFNO1  LDU     ,S              ; RELOAD OFFSET
1592 fee1 33 5f                      LEAU    -1,U            ; CONVERT TO LONG BRANCH OFFSET
1593 fee3 ef 84                      STU     ,X              ; STORE BACK WHERE X POINTS NOW
1594 fee5 3f                         SWI                     ; SHOW TWO BYTE OFFSET
1595 fee6 05                         FCB     OUT4HS          ; FUNCTION
1596 fee7 3f                         SWI                     ; FORCE NEW LINE
1597 fee8 06                         FCB     PCRLF           ; FUNCTION
1598 fee9 35 96                      PULS    PC,X,D          ; RESTORE STACK AND END COMMAND
1599                         *H
1600                         
1601                         *************BREAKPOINT - DISPLAY/ENTER/DELETE/CLEAR
1602                         *************             BREAKPOINTS
1603 feeb 27 23              CBKPT   BEQ     CBKDSP          ; BRANCH DISPLAY OF JUST 'B'
1604 feed 17 fd f1                   LBSR    BLDNUM          ; ATTEMPT VALUE ENTRY
1605 fef0 27 2c                      BEQ     CBKADD          ; BRANCH TO ADD IF SO
1606 fef2 81 2d                      CMPA    #'-             ; ? CORRECT DELIMITER
1607 fef4 26 3f                      BNE     CBKERR          ; NO, BRANCH FOR ERROR
1608 fef6 17 fd e8                   LBSR    BLDNUM          ; ATTEMPT DELETE VALUE
1609 fef9 27 03                      BEQ     CBKDLE          ; GOT ONE, GO DELETE IT
1610 fefb 0f fe                      CLR     <BKPTCT         ; WAS 'B -', SO ZERO COUNT
1611 fefd 39                 CBKRTS  RTS                     ; END COMMAND
1612                         * DELETE THE ENTRY
1613 fefe 8d 40              CBKDLE  BSR     CBKSET          ; SETUP REGISTERS AND VALUE
1614 ff00 5a                 CBKDLP  DECB                    ; ? ANY ENTRIES IN TABLE
1615 ff01 2b 32                      BMI     CBKERR          ; BRANCH NO, ERROR
1616 ff03 ac a1                      CMPX    ,Y++            ; ? IS THIS THE ENTRY
1617 ff05 26 f9                      BNE     CBKDLP          ; NO, TRY NEXT
1618                         * FOUND, NOW MOVE OTHERS UP IN ITS PLACE
1619 ff07 ae a1              CBKDLM  LDX     ,Y++            ; LOAD NEXT ONE UP
1620 ff09 af 3c                      STX     -4,Y            ; MOVE DOWN BY ONE
1621 ff0b 5a                         DECB                    ; ? DONE
1622 ff0c 2a f9                      BPL     CBKDLM          ; NO, CONTINUE MOVE
1623 ff0e 0a fe                      DEC     <BKPTCT         ; DECREMENT BREAKPOINT COUNT
1624 ff10 8d 2e              CBKDSP  BSR     CBKSET          ; SETUP REGISTERS AND LOAD VALUE
1625 ff12 27 e9                      BEQ     CBKRTS          ; RETURN IF NONE TO DISPLY
1626 ff14 30 a1              CBKDSL  LEAX    ,Y++            ; POINT TO NEXT ENTRY
1627 ff16 3f                         SWI                     ; DISPLAY IN HEX
1628 ff17 05                         FCB     OUT4HS          ; FUNCTION
1629 ff18 5a                         DECB                    ; COUNT DOWN
1630 ff19 26 f9                      BNE     CBKDSL          ; LOOP IF NGABLE RAM
1631 ff1b 3f                         SWI                     ; SKIP TO NEW LINK
1632 ff1c 06                         FCB     PCRLF           ; FUNCTIONRTS
1633 ff1d 39                         RTS
1634                         
1635                         * ADD NEW ENTRY
1636 ff1e 8d 20              CBKADD  BSR     CBKSET          ; SETUP REGISTERS
1637 ff20 c1 08                      CMPB    #NUMBKP         ; ? ALREADY FULL
1638 ff22 27 11                      BEQ     CBKERR          ; BRANCH ERROR IF SO
1639 ff24 a6 84                      LDA     ,X              ; LOAD BYTE TO TRAP
1640 ff26 e7 84                      STB     ,X              ; TRY TO CHANGE
1641 ff28 e1 84                      CMPB    ,X              ; ? CHANGEABLE RAM
1642 ff2a 26 09                      BNE     CBKERR          ; BRANCH ERROR IF NOT
1643 ff2c a7 84                      STA ,X                  ; RESTORE BYTE
1644 ff2e 5a                 CBKADL  DECB                    ; COUNT DOWN
1645 ff2f 2b 07                      BMI     CBKADT          ; BRANCH IF DONE TO ADD IT
1646 ff31 ac a1                      CMPX    ,Y++            ; ? ENTRY ALREADY HERE
1647 ff33 26 f9                      BNE     CBKADL          ; LOOP IF NOT
1648 ff35 16 fa 24           CBKERR  LBRA    CMDBAD          ; RETURN TO ERROR PRODUCE
1649 ff38 af a4              CBKADT  STX ,Y                  ; ADD THIS ENTRY
1650 ff3a 6f 31                      CLR     -NUMBKP*2+1,Y   ; CLEAR OPTIONAL BYTE
1651 ff3c 0c fe                      INC     <BKPTCT         ; ADD ONE TO COUNT
1652 ff3e 20 d0                      BRA     CBKDSP          ; AND NOW DISPLAY ALL OF 'EM
1653                         * SETUP REGISTERS FOR SCAN
1654 ff40 9e 9f              CBKSET  LDX     <NUMBER         ; LOAD VALUE DESIRED
1655 ff42 31 8d 61 70        CBKLDR  LEAY    BKPTBL,PCR      ; LOAD START OF TABLE
1656 ff46 d6 fe                      LDB     <BKPTCT         ; LOAD ENTRY COUNT
1657 ff48 39                         RTS                     ; RETURN
1658                         
1659                         *****************ENCODE  -  ENCODE A POSTBYTE
1660 ff49 6f e2              CENCDE  CLR     ,-S             ; DEFAULT TO NOT INDIRECT
1661 ff4b 5f                         CLRB                    ; ZERO POSTBYTE VALUE
1662 ff4c 30 8c 3f                   LEAX    <CONV1,PCR      ; START TABLE SEARCH
1663 ff4f 3f                         SWI                     ; OBTAIN FIRST CHARACTER
1664 ff50 00                         FCB     INCHNP          ; FUNCTION
1665 ff51 81 5b                      CMPA    #'[             ; ? INDIRECT HERE
1666 ff53 26 06                      BNE     CEN2            ; BRANCH IF NOT
1667 ff55 86 10                      LDA     #$10            ; SET INDIRECT BIT ON
1668 ff57 a7 e4                      STA     ,S              ; SAVE FOR LATER
1669 ff59 3f                 CENGET  SWI                     ; OBTAIN NEXT CHARACTER
1670 ff5a 00                         FCB     INCHNP          ; FUNCTION
1671 ff5b 81 0d              CEN2    CMPA    #CR             ; ? END OF ENTRY
1672 ff5d 27 0c                      BEQ     CEND1           ; BRANCH YES
1673 ff5f 6d 84              CENLP1  TST     ,X              ; ? END OF TABLE
1674 ff61 2b d2                      BMI     CBKERR          ; BRANCH ERROR IF SO
1675 ff63 a1 81                      CMPA    ,X++            ; ? THIS THE CHARACTER
1676 ff65 26 f8                      BNE     CENLP1          ; BRANCH IF NOT
1677 ff67 eb 1f                      ADDB    -1,X            ; ADD THIS VALUE
1678 ff69 20 ee                      BRA     CENGET          ; GET NEXT INPUT
1679 ff6b 30 8c 49           CEND1   LEAX    <CONV2,PCR      ; POINT AT TABLE 2
1680 ff6e 1f 98                      TFR     B,A             ; SAVE COPY IN A
1681 ff70 84 60                      ANDA    #$60            ; ISOLATE REGISTER MASK
1682 ff72 aa e4                      ORA     ,S              ; ADD IN INDIRECTION BIT
1683 ff74 a7 e4                      STA     ,S              ; SAVE BACK AS POSTBYTE SKELETON
1684 ff76 c4 9f                      ANDB    #$9F            ; CLEAR REGISTER BITS
1685 ff78 6d 84              CENLP2  TST     ,X              ; ? END OF TABLE
1686 ff7a 27 b9                      BEQ     CBKERR          ; BRANCH ERROR IF SO
1687 ff7c e1 81                      CMPB    ,X++            ; ? SAME VALUE
1688 ff7e 26 f8                      BNE     CENLP2          ; LOOP IF NOT
1689 ff80 e6 1f                      LDB     -1,X            ; LOAD RESULT VALUE
1690 ff82 ea e4                      ORB     ,S              ; ADD TO BASE SKELETON
1691 ff84 e7 e4                      STB     ,S              ; SAVE POSTBYTE ON STACK
1692 ff86 30 e4                      LEAX    ,S              ; POINT TO IT
1693 ff88 3f                         SWI                     ; SEND OUT AS HEX
1694 ff89 04                         FCB     OUT2HS          ; FUNCTION
1695 ff8a 3f                         SWI                     ; TO NEXT LINE
1696 ff8b 06                         FCB     PCRLF           ; FUNCTION
1697 ff8c 35 84                      PULS    PC,B            ; END OF COMMAND
1698                         
1699                         * TABLE ONE DEFINES VALID INPUT IN SEQUENCE
1700                         CONV1
1701 ff8e 41 04 42 05 44 06          FCB     'A,$04,'B,$05,'D,$06,'H,$01
     48 01
1702 ff96 48 01 48 01 48 00          FCB     'H,$01,'H,$01,'H,$00,',,$00
     2c 00
1703 ff9e 2d 09 2d 01 53 70          FCB     '-,$09,'-,$01,'S,$70,'Y,$30
     59 30
1704 ffa6 55 50 58 10 2b 07          FCB     'U,$50,'X,$10,'+,$07,'+,$01
     2b 01
1705 ffae 50 80 43 00 52 00          FCB     'P,$80,'C,$00,'R,$00,'],$00
     5d 00
1706 ffb6 ff                         FCB     $FF             ; END OF TABLE
1707                         
1708                         * CONV2 USES ABOVE CONVERSION TO SET POSTBYTE
1709                         * BIT SKELETON.
1710                         CONV2
1711 ffb7 10 84 11 00                FDB     $1084,$1100     ; R,      H,R
1712 ffbb 12 88 13 89                FDB     $1288,$1389     ; HH,R    HHHH,R
1713 ffbf 14 86 15 85                FDB     $1486,$1585     ; A,R     B,R
1714 ffc3 16 8b 17 80                FDB     $168B,$1780     ; D,R     ,R+
1715 ffc7 18 81 19 82                FDB     $1881,$1982     ; ,R++    ,-R
1716 ffcb 1a 83 82 8c                FDB     $1A83,$828C     ; ,--R    HH,PCR
1717 ffcf 83 8d 03 9f                FDB     $838D,$039F     ; HHHH,PCR [HHHH]
1718 ffd3 00                         FCB     0               ; END OF TABLE
