1720                         ****************************************************
1721                         *            DEFAULT INTERRUPT TRANSFERS           *
1722                         ****************************************************
1723 ffd4 6e 9d 60 f2        RSRVD   JMP     [VECTAB+.RSVD,PCR]      ; RESERVED VECTOR
1724 ffd8 6e 9d 60 f0        SWI3    JMP     [VECTAB+.SWI3,PCR]      ; SWI3 VECTOR
1725 ffdc 6e 9d 60 ee        SWI2    JMP     [VECTAB+.SWI2,PCR]      ; SWI2 VECTOR
1726 ffe0 6e 9d 60 ec        FIRQ    JMP     [VECTAB+.FIRQ,PCR]      ; FIRQ VECTOR
1727 ffe4 6e 9d 60 ea        IRQ     JMP     [VECTAB+.IRQ,PCR]       ; IRQ VECTOR
1728 ffe8 6e 9d 60 e8        SWI     JMP     [VECTAB+.SWI,PCR]       ; SWI VECTOR
1729 ffec 6e 9d 60 e6        NMI     JMP     [VECTAB+.NMI,PCR]       ; NMI VECTOR
1730                         
1731                         ******************************************************
1732                         *            ASSIST09 HARDWARE VECTOR TABLE
1733                         * THIS TABLE IS USED IF THE ASSIST09 ROM ADDRESSES
1734                         * THE MC6809 HARDWARE VECTORS.
1735                         ******************************************************
1736 fff0                            ORG     ROMBEG+ROMSIZ-16 ; SETUP HARDWARE VECTORS
1737 fff0 ff d4                      FDB     RSRVD           ; RESERVED SLOT
1738 fff2 ff d8                      FDB     SWI3            ; SOFTWARE INTERRUPT 3
1739 fff4 ff dc                      FDB     SWI2            ; SOFTWARE INTERRUPT 2
1740 fff6 ff e0                      FDB     FIRQ            ; FAST INTERRUPT REQUEST
1741 fff8 ff e4                      FDB     IRQ             ; INTERRUPT REQUEST
1742 fffa ff e8                      FDB     SWI             ; SOFTWARE INTERRUPT
1743 fffc ff ec                      FDB     NMI             ; NON-MASKABLE INTERRUPT
1744 fffe f8 3b                      FDB     RESET           ; RESTART
